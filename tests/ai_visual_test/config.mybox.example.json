{
  "base_url": "http://127.0.0.1:3000/",
  "navigation_timeout_ms": 30000,
  "ready_selector": ".sangtian-window",
  "startup_actions": [
    {
      "name": "打开 LIVE 页面",
      "type": "click",
      "role": "button",
      "name": "直播",
      "exact": true,
      "timeout_ms": 8000
    }
  ],
  "viewports": [
    {"name": "mobile-320", "width": 320, "height": 740},
    {"name": "mobile-360", "width": 360, "height": 800},
    {"name": "mobile-390", "width": 390, "height": 844},
    {"name": "mobile-412", "width": 412, "height": 915}
  ],
  "key_selectors": [
    "header",
    ".live-custom-source-tools",
    ".sangtian-window",
    ".sangtian-window-bar",
    ".sangtian-window-body",
    ".live-current-bar",
    ".live-category-tabs-scroll",
    ".live-channel-grid"
  ],
  "geometry_selectors": [
    "header",
    ".live-custom-source-tools",
    ".sangtian-window",
    ".live-current-bar",
    ".live-category-tabs-scroll",
    ".live-channel-grid"
  ],
  "interactions": [
    {
      "name": "切换直播分类",
      "trigger": ".live-category-tab:nth-child(2)",
      "target": ".live-category-tab:nth-child(2).active",
      "expected": "visible",
      "timeout_ms": 5000
    }
  ],
  "check_horizontal_overflow": true,
  "check_button_names": true,
  "block_external_requests": true,
  "visual_difference_threshold": 0.015,
  "visual_pixel_threshold": 20
}
